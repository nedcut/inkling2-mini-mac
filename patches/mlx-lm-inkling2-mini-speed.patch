+++ b/mlx_lm/models/inkling2/quantized_attention.py
@@ -0,0 +1,145 @@
+# Copyright © 2026 Apple Inc.
+
+import mlx.core as mx
+
+from mlx_lm.kernels.common import scalar
+from mlx_lm.models.inkling2.kernels import (
+    _BQ,
+    _RELATIVE_ATTENTION_ACCUMULATE,
+    _RELATIVE_ATTENTION_LOOP,
+    _RELATIVE_ATTENTION_SETUP,
+    _TG,
+    decode_relative_mask,
+)
+
+# Load affine codes straight into the same threadgroup tiles as BF16 prefill.
+# Each lane reconstructs eight values from one quantization group.
+_AFFINE_TILE = """
+        constexpr int PER_WORD = 32 / BITS;
+        constexpr uint CODE_MASK = (1u << BITS) - 1;
+        for (int c = tid; c < BK * D / 8; c += TG) {
+            const int r = c / (D / 8);
+            const int col = (c % (D / 8)) * 8;
+            const int key = k0 + r;
+            if (key < S) {
+                const auto kw = k + batch * k_strides[0] + kv_head * k_strides[1]
+                    + key * k_strides[2] + col / PER_WORD;
+                const auto vw = v + batch * v_strides[0] + kv_head * v_strides[1]
+                    + key * v_strides[2] + col / PER_WORD;
+                const int group = col / GROUP;
+                const auto ks = k_scale[batch * k_scale_strides[0]
+                    + kv_head * k_scale_strides[1] + key * k_scale_strides[2] + group];
+                const auto kb = k_bias[batch * k_bias_strides[0]
+                    + kv_head * k_bias_strides[1] + key * k_bias_strides[2] + group];
+                const auto vs = v_scale[batch * v_scale_strides[0]
+                    + kv_head * v_scale_strides[1] + key * v_scale_strides[2] + group];
+                const auto vb = v_bias[batch * v_bias_strides[0]
+                    + kv_head * v_bias_strides[1] + key * v_bias_strides[2] + group];
+                for (int j = 0; j < 8; ++j) {
+                    const int shift = (j % PER_WORD) * BITS;
+                    const float kc = float((kw[j / PER_WORD] >> shift) & CODE_MASK);
+                    const float vc = float((vw[j / PER_WORD] >> shift) & CODE_MASK);
+                    Ks[(col + j) * LDK + r] = half(float(T(fma(kc, float(ks), float(kb)))));
+                    Vs[r * LDV + col + j] = half(float(T(fma(vc, float(vs), float(vb)))));
+                }
+            } else {
+                for (int j = 0; j < 8; ++j) {
+                    Ks[(col + j) * LDK + r] = 0.0h;
+                    Vs[r * LDV + col + j] = 0.0h;
+                }
+            }
+        }
+"""
+
+_quantized_relative_attention = mx.fast.metal_kernel(
+    name="inkling_quantized_relative_attention",
+    input_names=[
+        "q",
+        "k",
+        "k_scale",
+        "k_bias",
+        "v",
+        "v_scale",
+        "v_bias",
+        "rel",
+        "sinks",
+        "key_start",
+        "sizes",
+        "scale",
+    ],
+    output_names=["out"],
+    source=(
+        _RELATIVE_ATTENTION_SETUP
+        + _RELATIVE_ATTENTION_LOOP
+        + _AFFINE_TILE
+        + _RELATIVE_ATTENTION_ACCUMULATE
+    ),
+    ensure_row_contiguous=False,
+)
+
+
+def _prefill(q, keys, values, rel, sinks, scale, group_size, bits):
+    batch, heads, length, dim = q.shape
+    kv_heads, context = keys[0].shape[1:3]
+    return _quantized_relative_attention(
+        inputs=[
+            q,
+            *keys,
+            *values,
+            mx.contiguous(rel),
+            mx.contiguous(sinks.astype(mx.float32)),
+            mx.zeros((batch,), dtype=mx.int32),
+            mx.array([length, context], dtype=mx.int32),
+            scalar(scale),
+        ],
+        template=[
+            ("T", q.dtype),
+            ("D", dim),
+            ("HQ", heads),
+            ("HKV", kv_heads),
+            ("R", rel.shape[-1]),
+            ("WINDOW", 0),
+            ("BQ", _BQ),
+            ("TG", _TG),
+            ("GROUP", group_size),
+            ("BITS", bits),
+        ],
+        grid=((length + _BQ - 1) // _BQ * _TG, heads, batch),
+        threadgroup=(_TG, 1, 1),
+        output_shapes=[(batch, length, heads, dim)],
+        output_dtypes=[q.dtype],
+    )[0]
+
+
+def _decode(q, keys, values, rel, sinks, scale, group_size, bits):
+    batch, heads, _, dim = q.shape
+    kv_heads, context = keys[0].shape[1:3]
+
+    grouped_q = q.reshape(batch, kv_heads, heads // kv_heads, 1, dim)
+    keys = tuple(x[:, :, None] for x in keys)
+    values = tuple(x[:, :, None] for x in values)
+    opts = dict(group_size=group_size, bits=bits)
+    logits = mx.quantized_matmul(
+        grouped_q.astype(mx.float32), *keys, transpose=True, **opts
+    ) * scale
+    if batch == 1:
+        bias = decode_relative_mask(rel, context, context - 1, 0, rel.dtype)
+    else:
+        distance = mx.arange(context - 1, -1, -1)
+        extent = rel.shape[-1]
+        bias = mx.take(rel[:, 0], mx.minimum(distance, extent - 1), axis=-1)
+        bias = mx.where(distance < extent, bias, 0)
+    logits += bias.reshape(batch, kv_heads, -1, 1, context)
+    # The sink participates in normalization and contributes a zero value.
+    sink_logits = sinks.astype(q.dtype).reshape(batch, kv_heads, -1, 1, 1)
+    probs = mx.softmax(mx.concatenate([logits, sink_logits], axis=-1), axis=-1)
+    out = mx.quantized_matmul(probs[..., :context], *values, transpose=False, **opts)
+    return out.reshape(batch, 1, heads, dim).astype(q.dtype)
+
+
+def attend_quantized(q, key, value, rel, sinks, cache, *, scale):
+    if mx.default_device() != mx.gpu or not mx.metal.is_available():
+        raise ValueError("Inkling quantized KV attention requires a Metal GPU.")
+    keys, values = cache.update_and_fetch(key, value)
+    attention = _decode if q.shape[2] == 1 else _prefill
+    return attention(q, keys, values, rel, sinks, scale, cache.group_size, cache.bits)
