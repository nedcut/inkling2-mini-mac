+
+
+_DECODE_RELATIVE_MASK_SOURCE = """
+    uint key = thread_position_in_grid.x;
+    uint head = thread_position_in_grid.y;
+    int distance = last_slot - int(key);
+    if (distance < 0) {
+        distance += int(key_count);
+    }
+    T value = T(0);
+    if (WINDOW > 0 && distance >= WINDOW) {
+        value = T(-INFINITY);
+    } else if (distance < R) {
+        value = T(bias[head * R + distance]);
+    }
+    mask[head * key_count + key] = value;
+"""
+
+_decode_relative_mask_kernel = mx.fast.metal_kernel(
+    name="decode_relative_mask",
+    input_names=["bias", "key_count", "last_slot"],
+    output_names=["mask"],
+    source=_DECODE_RELATIVE_MASK_SOURCE,
+)
+
+
+def decode_relative_mask(
+    bias: mx.array, key_count: int, last_slot: int, window: int, dtype: mx.Dtype
+) -> mx.array:
+    heads, extent = bias.shape[-2:]
+    return _decode_relative_mask_kernel(
+        inputs=[bias, mx.array(key_count, mx.uint32), mx.array(last_slot, mx.int32)],
+        template=[("R", extent), ("WINDOW", window), ("T", dtype)],
+        grid=(key_count, heads, 1),
+        threadgroup=(128, 1, 1),
+        output_shapes=[(heads, key_count)],
+        output_dtypes=[dtype],
+    )[0]
+
+
+_SHORT_CONVOLUTION_SOURCE = """
+    uint channel = thread_position_in_grid.x;
+    uint token = thread_position_in_grid.y;
+    uint offset = token * CHANNELS + channel;
+    if (STATE_ONLY) {
+        if (token < 3) {
+            uint source = (length + token) * CHANNELS + channel;
+            window[offset] = length + token < 3 ? previous[source]
+                : float(hidden[source - 3 * CHANNELS]);
+        }
+    } else {
+        window[offset] = token < 3 ? previous[offset] : float(hidden[offset - 3 * CHANNELS]);
+    }
+    if (token >= length) {
+        return;
+    }
+
+    float residual = float(hidden[offset]);
+    float acc = 0.0f;
+    const device bfloat16_t* taps = weight + 4 * channel;
+    for (uint tap = 0; tap < 4; ++tap) {
+        uint slot = offset + tap * CHANNELS;
+        bfloat16_t value = token + tap < 3
+            ? bfloat16_t(previous[slot])
+            : hidden[slot - 3 * CHANNELS];
+        acc = fma(float(value), float(taps[tap]), acc);
+    }
+    // Conv1d rounds to the weight dtype before the residual add.
+    output[offset] = bfloat16_t((float(bfloat16_t(acc)) + residual) / divisor);
+"""
+
+_short_convolution_kernel = mx.fast.metal_kernel(
+    name="inkling2_short_convolution",
+    input_names=["hidden", "previous", "weight", "length", "divisor"],
+    output_names=["output", "window"],
+    source=_SHORT_CONVOLUTION_SOURCE,
+)
+
+
+def short_convolution(
+    hidden: mx.array, previous: mx.array, weight: mx.array, *, state_only: bool = False
+) -> tuple[mx.array, mx.array]:
+    """Four-tap BF16 convolution and its FP32 window or trailing state."""
+    _, length, channels = hidden.shape
+    out, window = _short_convolution_kernel(
+        inputs=[
+            hidden, previous, weight, mx.array(length, mx.uint32), mx.array(5**0.5, mx.float32)
+        ],
+        template=[("CHANNELS", channels), ("STATE_ONLY", state_only)],
+        grid=(channels, max(length, 3) if state_only else length + 3, 1),
+        threadgroup=(128, 1, 1),
+        output_shapes=[hidden.shape, (1, 3 if state_only else length + 3, channels)],
+        output_dtypes=[mx.bfloat16, mx.float32],
+    )
+    return out, window
+
+
+_MOE_CONVOLUTION_SOURCE = """
+    #pragma clang fp contract(off)
+    uint channel = thread_position_in_grid.x;
+    // Match the FP32 products and sum, then round before convolution.
+    float combined = 0.0f;
+    for (uint expert = 0; expert < EXPERTS; ++expert) {
+        combined += float(experts[expert * CHANNELS + channel]) * routing[expert];
+    }
+    bfloat16_t hidden = bfloat16_t(combined);
+    const device bfloat16_t* taps = weight + 4 * channel;
+    float acc = 0.0f;
+    for (uint tap = 0; tap < 3; ++tap) {
+        uint slot = tap * CHANNELS + channel;
+        float sample = previous[slot];
+        window[slot] = sample;
+        acc = fma(float(bfloat16_t(sample)), float(taps[tap]), acc);
+    }
+    window[3 * CHANNELS + channel] = float(hidden);
+    acc = fma(float(hidden), float(taps[3]), acc);
+    bfloat16_t convolved = bfloat16_t(
+        (float(bfloat16_t(acc)) + float(hidden)) / divisor
+    );
+    output[channel] = bfloat16_t(residual[channel] + float(convolved));
+"""
+
+_moe_convolution_kernel = mx.fast.metal_kernel(
+    name="inkling2_moe_convolution",
+    input_names=["experts", "routing", "previous", "weight", "residual", "divisor"],
+    output_names=["output", "window"],
+    source=_MOE_CONVOLUTION_SOURCE,
+)
+
+
+def moe_convolution(experts, routing, previous, weight, residual):
+    channels = residual.shape[-1]
+    output, window = _moe_convolution_kernel(
+        inputs=[experts, routing, previous, weight, residual, scalar(5**0.5)],
+        template=[("CHANNELS", channels), ("EXPERTS", experts.shape[-2])],
+        grid=(channels, 1, 1),
+        threadgroup=(128, 1, 1),
+        output_shapes=[residual.shape, (1, 4, channels)],
+        output_dtypes=[mx.bfloat16, mx.float32],
+    )
+    return output, window
+
+
+_SORTED_EXPERT_REDUCE_SOURCE = """
+    #pragma clang fp contract(off)
+    uint channel = thread_position_in_grid.x;
+    uint token = thread_position_in_grid.y;
+    uint base = token * TOP_K;
+    float combined = 0.0f;
+    for (uint expert = 0; expert < TOP_K; ++expert) {
+        uint slot = base + expert;
+        combined += float(experts[inverse[slot] * CHANNELS + channel]) * routing[slot];
+    }
+    output[token * CHANNELS + channel] = combined;
+"""
+
+_sorted_expert_reduce_kernel = mx.fast.metal_kernel(
+    name="inkling2_sorted_expert_reduce",
+    input_names=["experts", "inverse", "routing"],
+    output_names=["output"],
+    source=_SORTED_EXPERT_REDUCE_SOURCE,
+)
+
+
+def sorted_expert_reduce(experts, inverse, routing):
+    """Reduce sorted expert rows in their original top-k order."""
+    channels, top_k = experts.shape[-1], routing.shape[-1]
+    return _sorted_expert_reduce_kernel(
+        inputs=[experts, inverse, routing],
+        template=[("CHANNELS", channels), ("TOP_K", top_k)],
+        grid=(channels, routing.size // top_k, 1),
+        threadgroup=(128, 1, 1),
+        output_shapes=[routing.shape[:-1] + (channels,)],
+        output_dtypes=[mx.float32],
+    )[0]
