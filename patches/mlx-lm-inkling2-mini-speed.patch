+        int d = int(tid) + p * TG;
+        if (d < D) {
+            for (int i = 0; i < K; ++i) {
+                xr[p][i] = blocks[(size_t(i) * rows + row) * D + d];
+            }
+            xr[p][K] = partial[size_t(row) * D + d];
+            for (int j = 0; j < Q; ++j) {
